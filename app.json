{
  "expo": {
    "name": "ClimaNuvem-prueba",
    "slug": "climanuvem-prueba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "climanuvem",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.javier.climanuvem",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.javier.climanuvem",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB_FueVvk_Dl5cNpMBuJtN51XJH7Mc0gqE"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-square.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-dark-square.png",
            "backgroundColor": "#1e2a44"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photos to upload images for weather analysis.",
          "cameraPermission": "We need access to your camera to take photos for weather analysis."
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "react-native-fast-tflite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43c86f4e-223c-4927-8fb3-f463fdb0be85"
      }
    }
  }
}
